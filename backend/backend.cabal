cabal-version: 3.0
name: backend
version: 0.1.0.0
build-type: Simple

executable backend
  main-is: Main.hs
  other-modules:
      Backend
    , DB
  hs-source-dirs: app, src
  default-language: Haskell2010
  build-depends:
      base >= 4.14 && < 5
    , common
    , servant
    , servant-server
    , wai
    , wai-cors
    , warp
    , aeson
    , text
    , mysql-simple
    , resource-pool

