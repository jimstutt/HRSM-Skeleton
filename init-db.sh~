#!/usr/bin/env bash
set -euo pipefail

echo "[HRSM] Checking MariaDB service status..."

# Check if the mariadb systemd service is active
if ! systemctl is-active --quiet mariadb; then
    echo "[HRSM] ERROR: MariaDB service is not running."
    echo "[HRSM] Please ensure the following is in your /etc/nixos/configuration.nix:"
    echo ""
    echo "  services.mysql = {"
    echo "    enable = true;"
    echo "    package = pkgs.mariadb;"
    echo "  };"
    echo ""
    echo "[HRSM] Then run: sudo nixos-rebuild switch"
    echo "[HRSM] And start the service: sudo systemctl start mariadb"
    exit 1
fi

echo "[HRSM] MariaDB is running. Creating database..."
nix shell nixpkgs#mariadb -c mariadb -u root -e "CREATE DATABASE IF NOT EXISTS project_db;"

echo "[HRSM] Applying schema..."
nix shell nixpkgs#mariadb -c mariadb -u root project_db < ~/Dev/HRSM-Skeleton/backend/sql/schema.sql

echo "[HRSM] Verifying tables..."
nix shell nixpkgs#mariadb -c mariadb -u root project_db -e "SHOW TABLES;"

echo "[HRSM] Database setup complete."
